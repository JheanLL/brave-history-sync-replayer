{
  "manifest_version": 3,
  "name": "Brave History Sync Replayer",
  "version": "1.0",
  "description": "Reenvía el historial local completo a Brave Sync para sincronizarlo con Android.",
  "permissions": [
    "history",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
